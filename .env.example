# Copy to .env.local for local development. Never commit real values.
#
# In production these are secrets, not variables:
#   wrangler secret put RESEND_API_KEY
# or Workers & Pages > the project > Settings > Variables and Secrets.
#
# Nothing here is required to run the site. With no mail provider configured the
# contact form renders disabled and offers the published email address instead,
# which is the honest behaviour — a form that silently discards what someone
# writes is worse than no form.

# ---------------------------------------------------------------------------
# Contact form
#
# All three are read together. A partial configuration behaves exactly like no
# configuration, so the form can never be shown as working when it is not.
# ---------------------------------------------------------------------------

# Server-side only. https://resend.com/api-keys
RESEND_API_KEY=

# Where inquiries are delivered.
CONTACT_TO_EMAIL=

# Must be a sender verified on the Resend account, on a domain with SPF and
# DKIM aligned — otherwise mail is accepted by the provider and lands in spam.
CONTACT_FROM_EMAIL=
