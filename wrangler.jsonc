{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bumincetin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    // Next.js on Workers runs the Node.js runtime, not the Edge runtime.
    "nodejs_compat",
    // Required by OpenNext so the app can fetch its own public URLs.
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // No WORKER_SELF_REFERENCE service binding: OpenNext only needs it to drive
  // the ISR revalidation queue, and nothing here revalidates. Including it
  // would also make the very first deploy bind to a service that does not
  // exist yet. Add it back alongside NEXT_INC_CACHE_R2_BUCKET if ISR is ever
  // introduced.

  // Backs next/image. Without it the optimizer has no way to resize, and
  // <Image> falls back to serving the full-size original.
  "images": {
    "binding": "IMAGES"
  },

  "observability": {
    "enabled": true
  },

  // GEMINI_API_KEY is a secret and is deliberately not stored here. Set it with
  // `wrangler secret put GEMINI_API_KEY`, or under
  // Workers & Pages > bumincetin > Settings > Variables and Secrets.
  "vars": {}
}
