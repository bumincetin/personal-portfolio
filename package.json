{
  "name": "bumincetin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint .",
    "optimize:images": "node scripts/optimize-images.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:next": "next build",
    "test": "node --import ./scripts/register-test-resolver.mjs --test \"src/**/*.test.ts\"",
    "test:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:i18n && npm run test:contrast && npm run test && npm run build:next",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:redirects": "node scripts/check-redirects.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:experience": "node scripts/check-experience.mjs",
    "test:chapter-pages": "node scripts/check-chapter-pages.mjs",
    "test:e2e": "node scripts/check-portfolio.mjs",
    "generate:og": "node --import ./scripts/register-test-resolver.mjs scripts/generate-og.mjs",
    "test:generated": "node scripts/generate-palette.mjs --check",
    "test:enhancements": "node scripts/check-enhancements.mjs",
    "test:world": "node scripts/check-world.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@visx/group": "^4.0.1-alpha.0",
    "@visx/responsive": "^4.0.1-alpha.0",
    "@visx/shape": "^4.0.1-alpha.0",
    "clsx": "^2.1.1",
    "d3-shape": "^3.2.0",
    "lucide-react": "^0.561.0",
    "motion": "^13.3.0",
    "next": "^15.5.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "0.165.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.165.0",
    "autoprefixer": "^10.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "playwright": "^1.63.0",
    "postcss": "^8",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    },
    "brace-expansion@^1.1.7": "1.1.21"
  }
}
