{
  "name": "bumincetin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint .",
    "optimize:images": "node scripts/optimize-images.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:next": "next build",
    "test": "node --import ./scripts/register-test-resolver.mjs --test \"src/**/*.test.ts\"",
    "test:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:i18n && npm run test:contrast && npm run test && npm run build:next",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:redirects": "node scripts/check-redirects.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:canvas": "node scripts/check-canvas-contrast.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "framer-motion": "^12.5.0",
    "lucide-react": "^0.561.0",
    "next": "^15.5.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.165.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.165.0",
    "autoprefixer": "^10.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "playwright": "^1.63.0",
    "postcss": "^8",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  }
}
